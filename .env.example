# Scrubber configuration (copy to .env). Every variable is optional except the API key
# when you use `plan` or an `llm_fix` op. Defaults shown.

# Required for `scrubber plan` / `run` and for plans containing `llm_fix` (not for `apply --no-llm`)
OPENAI_API_KEY=

# "<provider>:<model>" (only langchain-openai is installed)
LLM_MODEL=openai:gpt-5-mini
# Optional stronger model for the planning call only. Owner's choice is pending its exact
# "<provider>:<model>" ID; leave unset to plan with LLM_MODEL.
# PLANNER_MODEL=
# JSON object passed to init_chat_model, e.g. {"reasoning_effort": "low"}
LLM_MODEL_KWARGS={}
# Seconds per LLM call (reasoning models can take minutes)
LLM_TIMEOUT=180
# Provider-client retries for transport errors / 429 / 5xx
LLM_MAX_RETRIES=2

# Rows profiled / previewed (CSV: seeded reservoir sample; SQL: first N by key; Mongo: $sample)
SAMPLE_SIZE=1000
# Rows per read/write batch (one transaction per batch for SQL/Mongo writers)
BATCH_SIZE=1000
# Unique cells per LLM call
LLM_CELLS_PER_CALL=40
# Parallel LLM calls while resolving llm_fix cells
LLM_CONCURRENCY=4
# Cap on unique cells sent to the LLM per run (the rest are flagged)
MAX_LLM_CELLS=5000
# Longer cell values never go to the LLM
LLM_MAX_VALUE_CHARS=2000
# Planner repair rounds when the plan fails validation
PLANNER_MAX_REPAIRS=2
# Profile JSON size budget for the planning prompt
PLANNER_MAX_PROFILE_CHARS=150000

# Run outputs: <OUTPUT_DIR>/<run_id>/ (cleaned file, changes.csv, flags.csv, plan.json, report.json)
OUTPUT_DIR=output
# Uploaded CSVs (API only)
UPLOAD_DIR=data/uploads
MAX_UPLOAD_MB=200
# Built web UI served by `scrubber serve` (default: <repo>/web/dist)
# WEB_DIST=

# Set to 1 when running the Vite dev server (allows the http://localhost:5173 origin)
# SCRUBBER_DEV=1
