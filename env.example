# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=8000
OPENAI_TEMPERATURE=0.1

# Operation-specific token limits
RULE_EXPANSION_MAX_TOKENS=1500
DATA_CLEANING_MAX_TOKENS=30000
VALIDATION_MAX_TOKENS=1500

# Processing Configuration
CHUNK_SIZE=250
MAX_RETRIES=1
RETRY_DELAY=5.0
ENABLE_PARALLEL_PROCESSING=true

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/csv_cleaner.log
ENABLE_DETAILED_LLM_LOGGING=true

# Output Configuration
OUTPUT_FORMAT=json
INCLUDE_CHANGE_LOG=true
GENERATE_SUMMARY=true

# Performance Configuration
MAX_CONCURRENT_REQUESTS=5
REQUEST_TIMEOUT=120.0
RATE_LIMIT_REQUESTS_PER_MINUTE=60
